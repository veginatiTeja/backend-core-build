# Backend Core Rebuild - Environment Configuration
# Copy this file to .env and update values for your environment

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Port on which the Express server listens
# Default: 5000
PORT=5000

# Node.js environment
# Options: development, production, test
# Default: development
NODE_ENV=development

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================

# Complete PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# Used in db.js if present; otherwise uses individual DB_* variables below
DATABASE_URL=postgresql://wallet_user:wallet_pass@localhost:5432/wallet_db

# PostgreSQL Host
# In Docker Compose: use "postgres" (service name)
# Local development: use "localhost"
# Default: localhost
DB_HOST=localhost

# PostgreSQL Port
# Default: 5432
DB_PORT=5432

# PostgreSQL Username
# For development, create this user with appropriate permissions
DB_USER=wallet_user

# PostgreSQL Password
# ⚠️ NEVER commit actual password to version control
# Use strong password (20+ chars) in production
DB_PASSWORD=wallet_pass

# PostgreSQL Database Name
DB_NAME=wallet_db

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Complete Redis connection string
# Format: redis://host:port
# Used for: BullMQ queues, caching, rate limiting
REDIS_URL=redis://localhost:6379

# Redis Host
# In Docker Compose: use "redis" (service name)
# Local development: use "localhost"
# Default: localhost
REDIS_HOST=localhost

# Redis Port
# Default: 6379
REDIS_PORT=6379

# ============================================================================
# AUTHENTICATION
# ============================================================================

# JWT Secret for signing authentication tokens
# ⚠️ CRITICAL: Use strong random string (minimum 32 characters)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ NEVER commit actual secret to version control
# ⚠️ Keep consistent across all services (API, workers, etc.)
JWT_SECRET=your-super-secret-key-min-32-chars-long-change-in-production

# JWT Token Expiration
# Format: "7d", "24h", "3600s" (any valid Token expiration format)
# Default: "7d"
JWT_EXPIRES_IN=7d

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level for Pino logger
# Options: debug, info, warn, error, fatal
# Default: info
# Note: Currently mixed with console.log (see technical debt)
LOG_LEVEL=info

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================

# Express rate limiter: max requests per windowMs
# Applied globally to all IP addresses
# Default: 100 requests
API_RATE_LIMIT=100

# Express rate limiter: window duration in milliseconds
# Default: 900000 (15 minutes)
API_RATE_LIMIT_WINDOW=900000

# User-based transfer rate limit (rate-limiter-flexible)
# Max transfers per user per window
# Default: 10
TRANSFER_RATE_LIMIT=10

# Transfer rate limit window in seconds
# Default: 3600 (1 hour)
TRANSFER_RATE_LIMIT_WINDOW=3600

# ============================================================================
# IDEMPOTENCY CONFIGURATION
# ============================================================================

# Redis TTL for idempotency keys (in seconds)
# Prevents duplicate processing of requests
# Default: 86400 (24 hours)
IDEMPOTENCY_KEY_TTL=86400

# ============================================================================
# JOB QUEUE CONFIGURATION
# ============================================================================

# Maximum attempts for BullMQ background jobs before DLQ
# Default: 3
JOB_MAX_ATTEMPTS=3

# Job retry delay in milliseconds (initial backoff)
# Uses exponential backoff: delay * 2^(attempt-1)
# Default: 5000 (5 seconds)
JOB_BACKOFF_DELAY=5000

# Maximum number of jobs to process concurrently per worker
# Default: 5
# Increase for high-throughput workers, decrease to reduce resource usage
JOB_CONCURRENCY=5

# ============================================================================
# WEBHOOK CONFIGURATION
# ============================================================================

# External webhook receiver URL
# Used for sending balance update events
# Example: http://localhost:4000
WEBHOOK_RECEIVER_URL=http://localhost:4000

# Webhook delivery timeout in milliseconds
# Default: 10000 (10 seconds)
WEBHOOK_TIMEOUT=10000

# Maximum webhook delivery attempts before DLQ
# Default: 5
WEBHOOK_MAX_ATTEMPTS=5

# ============================================================================
# RECONCILIATION CONFIGURATION
# ============================================================================

# Cron schedule for ledger reconciliation
# Format: cron expression
# Default: "0 * * * *" (hourly)
# See: https://www.npmjs.com/package/node-cron
RECONCILIATION_SCHEDULE=0 * * * *

# ============================================================================
# TRANSACTION LIMITS
# ============================================================================

# Maximum single transfer amount (in cents to avoid floating point)
# Default: 10000000 (100,000.00 in currency)
MAX_TRANSFER_AMOUNT=10000000

# Minimum transfer amount (in cents)
# Default: 1 (0.01)
MIN_TRANSFER_AMOUNT=1

# ============================================================================
# EXTERNAL SERVICE INTEGRATIONS
# ============================================================================

# (Add any external API keys, Third-party service URLs here as needed)
# Example:
# PAYMENT_GATEWAY_API_KEY=your-api-key
# ANALYTICS_SERVICE_URL=https://analytics.example.com

# ============================================================================
# DOCKER COMPOSE SPECIFIC
# ============================================================================

# These are automatically set by docker-compose.yml and override localhost values
# DO NOT set these manually unless running without Docker Compose

# Docker internal hostname (overrides DB_HOST when in container)
# Set by docker-compose: docker-compose sets DB_HOST=postgres, REDIS_HOST=redis
# Local .env should leave empty or use localhost
# In docker-compose override: DB_HOST=postgres, REDIS_HOST=redis

# ============================================================================
# NOTES FOR DEVELOPMENT
# ============================================================================

# 1. DOCKER COMPOSE USERS:
#    - Run: docker-compose up
#    - Services override DB_HOST to "postgres" and REDIS_HOST to "redis"
#    - This .env file is loaded into containers via env_file directive
#
# 2. LOCAL DEVELOPMENT (without Docker):
#    - Ensure PostgreSQL and Redis are running locally
#    - Use DB_HOST=localhost, REDIS_HOST=localhost
#
# 3. PRODUCTION DEPLOYMENT:
#    - Use strong random values for JWT_SECRET
#    - Store secrets in secure vault, not in .env files
#    - Set NODE_ENV=production
#    - Use external database (managed PostgreSQL)
#    - Use external Redis (managed cache)
#
# 4. SECURITY:
#    - NEVER commit actual .env file to git (only .env.example)
#    - Add .env to .gitignore (if not already)
#    - Rotate JWT_SECRET regularly
#    - Use different secrets per environment
#
# 5. VALIDATION:
#    - Check db.js for connection retry logic with timeouts
#    - Verify Redis connection before job processing
#    - Monitor log level for debugging vs performance
